@echo off
chcp 65001 >nul
rem ─────────────────────────────────────────────────────────────────────────
rem  Слияние набора, выгруженного из расширения (answers-new.json), с базой
rem  ответов opendu-helper\answers.json.
rem
rem  Как пользоваться: пройдитесь по решённому тесту и у каждого задания,
rem  которого нет в базе, нажмите 📋. Потом в окне расширения (клик по его
rem  значку на панели браузера) нажмите «Экспорт» и сохраните файл. После
rem  этого — двойной клик по этому файлу.
rem
rem  Старые записи не трогаются: новые дописываются в конец, повторы
rem  пропускаются, прежняя база сохраняется в answers.json.bak.
rem
rem  Можно перетащить файл набора прямо на этот .cmd.
rem ─────────────────────────────────────────────────────────────────────────
setlocal
cd /d "%~dp0"

where python >nul 2>&1
if errorlevel 1 (
    echo [!] Не найден python. Установите Python и добавьте его в PATH.
    pause
    exit /b 1
)

python merge-answers.py %*
echo.
pause
