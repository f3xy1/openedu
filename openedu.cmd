@echo off
chcp 65001 >nul
rem ─────────────────────────────────────────────────────────────────────────
rem  Меню всех скриптов проекта: консоль спросит, что сделать и с каким файлом.
rem
rem  Как пользоваться: двойной клик по этому файлу. Дальше — номер пункта и
rem  путь к файлу; путь можно перетащить в окно консоли мышью.
rem
rem  Можно перетащить файл прямо на этот .cmd — тогда он подставится в те
rem  вопросы, где подходит по расширению, и останется нажать Enter.
rem
rem  Вместо меню всегда можно запустить нужный скрипт напрямую: меню перед
rem  каждым запуском печатает строку «> ...» ровно с той командой, которая
rem  сработала.
rem ─────────────────────────────────────────────────────────────────────────
setlocal
cd /d "%~dp0"

where python >nul 2>&1
if errorlevel 1 (
    echo [!] Не найден python. Установите Python и добавьте его в PATH.
    pause
    exit /b 1
)

python openedu.py %*
echo.
pause
