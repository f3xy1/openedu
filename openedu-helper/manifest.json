{
  "manifest_version": 3,
  "name": "Openedu Helper",
  "version": "7.4",
  "description": "Помощник для прохождения тестов на openedu.ru",
  "permissions": ["storage", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Openedu Helper — набор снятых ответов"
  },
  "content_scripts": [
    {
      "matches": ["*://*.openedu.ru/*"],
      "js": ["normalize.js", "content.js", "nav.js"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["answers.json"],
      "matches": ["*://*.openedu.ru/*"]
    }
  ]
}
