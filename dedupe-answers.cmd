@echo off
chcp 65001 >nul
rem ─────────────────────────────────────────────────────────────────────────
rem  Проверка базы ответов opendu-helper\answers.json на дубликаты вопросов.
rem
rem  Как пользоваться: двойной клик по этому файлу. Скрипт найдёт записи об
rem  одном и том же вопросе, удалит все, кроме последней, и покажет, что именно
rem  выбросил, — дубликат с ДРУГИМ ответом стоит просмотреть глазами.
rem
rem  Прежняя база сохраняется в answers.json.bak.
rem  Если дубликатов нет — файл не трогается вообще.
rem
rem  Только посмотреть, ничего не меняя:
rem      python dedupe-answers.py --check
rem ─────────────────────────────────────────────────────────────────────────
setlocal
cd /d "%~dp0"

where python >nul 2>&1
if errorlevel 1 (
    echo [!] Не найден python. Установите Python и добавьте его в PATH.
    pause
    exit /b 1
)

python dedupe-answers.py %*
echo.
pause
